
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: Build active file",
            "type": "process",
            "command": "/usr/bin/gcc",
            "args": [
                "-std=c23",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
